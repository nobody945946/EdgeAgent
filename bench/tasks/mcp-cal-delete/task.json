   "read_only_tools": [
    "get_stock_daily_trading",
    "get_stock_history",
    "get_twse_institutional_investors_summary",
    "get_twse_institutional_investors_by_stock",
    "get_company_monthly_revenue",
    "get_company_dividend",
    "get_company_income_statement",
    "get_company_balance_sheet",
    "get_company_cash_flow_statement",
    "get_taiex_index_history",
    "get_exchange_rates"
   ],
   "clients": [
    "ui"
   ],
   "description": "台股資料：股價、三大法人買賣超、月營收、股利、財報、加權指數、匯率"
